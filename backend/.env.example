# Database — PostgreSQL for main database
DATABASE_URL=postgresql://postgres:root@localhost:5432/algolens
# SQLite fallback for fast offline iteration without Postgres:
# DATABASE_URL=sqlite:///./algolens.db

# JWT secrets — never commit real values
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Sandbox resource limits (Docker container constraints)
SANDBOX_CPU_QUOTA=50000
SANDBOX_CPU_PERIOD=100000
SANDBOX_MEMORY_MB=256
SANDBOX_PIDS_LIMIT=64
SANDBOX_WALL_TIMEOUT_S=10

# Benchmarking config
BENCHMARK_INPUT_SIZES=100,1000,10000,100000,1000000
BENCHMARK_REPETITIONS=3
BENCHMARK_WARMUP_RUNS=1

# Submission constraints
MAX_SOURCE_CODE_BYTES=65536
SUBMISSIONS_RATE_LIMIT_PER_MINUTE=5

# CORS — set to your deployed frontend URL in production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Sandbox Docker image name (built once via 'docker build')
SANDBOX_IMAGE_NAME=algolens-sandbox:latest

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/algolens.log

# SMTP Email Configuration
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@algolens.com
SMTP_USE_TLS=true
